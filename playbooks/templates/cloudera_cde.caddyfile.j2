{{ cloudera_cde_external_domain }}, *.{{ cloudera_cde_external_domain }} {

  reverse_proxy {{ cloudera_cde_scheme }}://{{ cloudera_cde_fqdn }}:{{ cloudera_cde_port }} {

    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Port 443
    header_up X-Forwarded-Proto https

    transport http {
      tls_insecure_skip_verify
      tls_server_name {{ cloudera_cde_external_domain }}
    }
  }
}

service.{{ cloudera_cde_external_domain }} {
  reverse_proxy {{ cloudera_cde_scheme }}://{{ cloudera_cde_fqdn }}:{{ cloudera_cde_port }} {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Port 443
    transport http {
      tls_insecure_skip_verify
      tls_server_name service.{{ cloudera_cde_external_domain }}
    }
  }
}