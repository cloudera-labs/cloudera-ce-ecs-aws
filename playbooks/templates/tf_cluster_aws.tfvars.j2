{% if ssh_pem_file is defined %}
ssh_private_key_file = "{{ ssh_pem_file }}"
{% endif %}
prefix               = "{{ name_prefix}}"
region               = "{{ infra_region }}"

{% if ingress_cidr is defined and ingress_cidr is iterable %}
vpc_ingress_cidr    = [
{%- set sep = joiner(",") %}
{% for c in ingress_cidr %}{{ sep() }}
  "{{ c }}"
{%- endfor %}

]

{% endif %}
public_domain              = "{{ public_domain }}"
private_domain             = "{{ dns_domain }}"

{% if asset_tags is defined and asset_tags is mapping %}
asset_tags = {
{%   for k, v in asset_tags.items() %}
  {{ k }} = "{{ v }}"
{%   endfor %}
}
{% endif %}
